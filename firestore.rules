rules_version = '2';
service cloud.firestore {
  // Para liberar alguém: criar o usuário no Firebase Auth (e-mail/senha) E incluir o e-mail
  // na lista certa abaixo, depois `firebase deploy --only firestore:rules`.
  function email() {
    return request.auth != null ? request.auth.token.email.lower() : '';
  }
  // Importa os ciclos da Campanha de Incentivo
  function admin() {
    return email() in [
      'usuario@exemplo.com'
    ];
  }
  // Preenchem a aba Avaliar
  function supervisor() {
    return admin() || email() in [
      'usuario@exemplo.com',
      'usuario@exemplo.com'
    ];
  }
  // Só consultam (consultores, comercial)
  function leitor() {
    return supervisor() || email() in [
      'usuario@exemplo.com'
    ];
  }
  function avaliacaoValida(id) {
    let d = request.resource.data;
    return d.keys().hasOnly(['mes', 'consultor', 'notas', 'feedback', 'avaliador', 'atualizadoEm'])
      && d.avaliador == email()
      && d.mes.matches('^[0-9]{4}-[0-9]{2}$')
      && id == d.mes + '__' + d.consultor
      && d.feedback is string && d.feedback.size() <= 1200
      && d.notas.keys().hasOnly(['postura', 'relacionamento', 'rota', 'execucao', 'proatividade'])
      && d.notas.size() == 5;
  }
  match /databases/{database}/documents {
    // Consultor com login próprio: acessos/{e-mail} = {id} (gravado pelo admin com publicar_ciclos.js).
    // Vê só a própria carta (cartas/{mes}__{id}) e a própria avaliação.
    function consultor() {
      return request.auth != null && exists(/databases/$(database)/documents/acessos/$(email()));
    }
    function meuId() {
      return get(/databases/$(database)/documents/acessos/$(email())).data.id;
    }
    match /ciclos/{mes} {
      allow read: if leitor();
      allow write: if admin();
    }
    match /cartas/{doc} {
      allow read: if leitor() || (consultor() && resource.data.id == meuId());
      allow write: if admin();
    }
    // Foto do consultor (miniatura em data URI, gravada por publicar_ciclos.js a partir de fotos.json)
    match /fotos/{id} {
      allow read: if leitor() || (consultor() && id == meuId());
      allow write: if admin();
    }
    match /acessos/{e} {
      allow get: if request.auth != null && (e == email() || admin());
      allow list, write: if admin();
    }
    match /avaliacoes/{id} {
      allow read: if leitor() || (consultor() && resource.data.consultor == meuId());
      allow create, update: if supervisor() && avaliacaoValida(id);
      allow delete: if admin();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
